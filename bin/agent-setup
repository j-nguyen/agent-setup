#!/usr/bin/env python3
"""agent-setup: install agent-agnostic skills, subagents and MCP servers into every coding agent.

Canonical sources live in this repo:
  mcp/<name>.json         MCP server, written into each tool's config
  skills/<name>/SKILL.md   Agent Skills standard (name + description frontmatter)
  agents/<name>.md         neutral subagent definition (see agents/README.md)

`sync` installs them:
  skills -> symlinked into each skills dir (edits in the repo are live)
  agents -> rendered into each tool's native subagent format

Only files this tool created (recorded in a manifest) are ever overwritten or
removed; anything else already in the target directories is left alone.

Standard library only.
"""
from __future__ import annotations

import argparse
import json
import os
import re
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
SKILLS_SRC = REPO / "skills"
AGENTS_SRC = REPO / "agents"
NAME_RE = re.compile(r"^[a-z0-9]+(-[a-z0-9]+)*$")
ACCESS_LEVELS = ("read-only", "edit", "full")
GENERATED = "Generated by agent-setup from {src}. Edit the source, then run `agent-setup sync`."


def home() -> Path:
    return Path(os.environ.get("HOME", str(Path.home())))


def codex_home() -> Path:
    return Path(os.environ.get("CODEX_HOME", str(home() / ".codex")))


def opencode_home() -> Path:
    xdg = os.environ.get("XDG_CONFIG_HOME", str(home() / ".config"))
    return Path(xdg) / "opencode"


def state_file() -> Path:
    xdg = os.environ.get("XDG_STATE_HOME", str(home() / ".local" / "state"))
    return Path(xdg) / "agent-setup" / "manifest.json"


# --------------------------------------------------------------------------- #
# Minimal frontmatter parser: scalars, quoted strings, > and | block scalars,
# inline [a, b] lists, and one level of nested maps. Enough for our sources.
# --------------------------------------------------------------------------- #
def _scalar(raw: str):
    raw = raw.strip()
    if raw[:1] not in ("\"", "'"):
        raw = re.sub(r"\s+#.*$", "", raw)  # trailing comment on an unquoted value
    if raw == "":
        return ""
    if raw[0] in "\"'" and raw[-1] == raw[0] and len(raw) >= 2:
        return json.loads(raw) if raw[0] == '"' else raw[1:-1].replace("''", "'")
    if raw.startswith("[") and raw.endswith("]"):
        return [_scalar(x) for x in raw[1:-1].split(",") if x.strip()]
    low = raw.lower()
    if low in ("true", "false"):
        return low == "true"
    if low in ("null", "~"):
        return None
    if re.fullmatch(r"-?\d+", raw):
        return int(raw)
    if re.fullmatch(r"-?\d+\.\d+", raw):
        return float(raw)
    return raw


def _parse_block(lines: list[str], indent: int) -> dict:
    out: dict = {}
    i = 0
    while i < len(lines):
        line = lines[i]
        if not line.strip() or line.lstrip().startswith("#"):
            i += 1
            continue
        cur = len(line) - len(line.lstrip())
        if cur < indent:
            break
        m = re.match(r"^\s*([A-Za-z0-9_.-]+):(.*)$", line)
        if not m:
            raise ValueError(f"cannot parse frontmatter line: {line!r}")
        key, rest = m.group(1), re.sub(r"^#.*$", "", m.group(2).strip())
        i += 1
        child: list[str] = []
        while i < len(lines) and (not lines[i].strip() or len(lines[i]) - len(lines[i].lstrip()) > cur):
            child.append(lines[i])
            i += 1
        if rest in (">", "|", ">-", "|-"):
            body = [c.strip() for c in child]
            out[key] = (" ".join(b for b in body if b) if rest.startswith(">") else "\n".join(body)).strip()
        elif rest == "":
            nested = [c for c in child if c.strip()]
            out[key] = _parse_block(child, len(nested[0]) - len(nested[0].lstrip())) if nested else None
        else:
            out[key] = _scalar(rest)
    return out


def read_frontmatter(path: Path) -> tuple[dict, str]:
    text = path.read_text(encoding="utf-8")
    if not text.startswith("---\n"):
        raise ValueError(f"{path}: missing '---' frontmatter")
    end = text.find("\n---", 4)
    if end == -1:
        raise ValueError(f"{path}: unterminated frontmatter")
    meta = _parse_block(text[4:end].splitlines(), 0)
    body = text[end + 4:].lstrip("\n")
    return meta, body


# --------------------------------------------------------------------------- #
# Emitters. JSON strings are valid YAML and valid TOML basic strings.
# --------------------------------------------------------------------------- #
def yaml_value(v, indent: int = 0) -> str:
    pad = "  " * indent
    if isinstance(v, dict):
        return "\n" + "\n".join(f"{pad}  {k}:{yaml_value(x, indent + 1)}" for k, x in v.items())
    if isinstance(v, list):
        return " [" + ", ".join(json.dumps(x) for x in v) + "]"
    if isinstance(v, bool):
        return " " + ("true" if v else "false")
    if isinstance(v, (int, float)):
        return f" {v}"
    return " " + json.dumps(str(v), ensure_ascii=False)


def yaml_frontmatter(meta: dict) -> str:
    return "---\n" + "\n".join(f"{k}:{yaml_value(v)}" for k, v in meta.items() if v is not None) + "\n---\n"


def toml_value(v) -> str:
    if isinstance(v, bool):
        return "true" if v else "false"
    if isinstance(v, (int, float)):
        return str(v)
    if isinstance(v, list):
        return "[" + ", ".join(toml_value(x) for x in v) + "]"
    return json.dumps(str(v), ensure_ascii=False)


def toml_multiline(s: str) -> str:
    if "'''" not in s:
        return "'''\n" + s.rstrip("\n") + "\n'''"
    return json.dumps(s, ensure_ascii=False)


# --------------------------------------------------------------------------- #
# Sources
# --------------------------------------------------------------------------- #
def load_skills() -> list[tuple[str, Path]]:
    found = []
    if not SKILLS_SRC.is_dir():
        return found
    for d in sorted(SKILLS_SRC.iterdir()):
        if not d.is_dir() or d.name.startswith((".", "_")):
            continue
        skill_md = d / "SKILL.md"
        if not skill_md.is_file():
            raise ValueError(f"{d}: missing SKILL.md")
        meta, _ = read_frontmatter(skill_md)
        if meta.get("name") != d.name:
            raise ValueError(f"{skill_md}: name {meta.get('name')!r} must match directory {d.name!r}")
        if not NAME_RE.match(d.name) or len(d.name) > 64:
            raise ValueError(f"{skill_md}: name must be lowercase-hyphenated, <=64 chars")
        desc = meta.get("description")
        if not isinstance(desc, str) or not desc.strip():
            raise ValueError(f"{skill_md}: description is required")
        if len(desc) > 1024:
            raise ValueError(f"{skill_md}: description must be <=1024 chars")
        found.append((d.name, d))
    return found


INCLUDE_RE = re.compile(r"^[ \t]*<!--\s*include:\s*(\S+)\s*-->[ \t]*$", re.MULTILINE)


def expand_includes(body: str, src: Path, depth: int = 0) -> str:
    """Replace `<!-- include: path/from/repo/root.md -->` lines with that file's contents.

    Lets a subagent embed the same reference files a skill ships, so there is one
    copy of each checklist and every tool gets a self-contained subagent prompt.
    """
    if depth > 5:
        raise ValueError(f"{src}: includes nested too deeply")

    def sub(m: re.Match) -> str:
        target = (REPO / m.group(1)).resolve()
        if REPO not in target.parents or not target.is_file():
            raise ValueError(f"{src}: include {m.group(1)!r} must be a file inside the repo")
        return expand_includes(target.read_text(encoding="utf-8").strip("\n"), target, depth + 1)

    return INCLUDE_RE.sub(sub, body)


def load_agents() -> list[dict]:
    found = []
    if not AGENTS_SRC.is_dir():
        return found
    for f in sorted(AGENTS_SRC.glob("*.md")):
        if f.name.upper() == "README.MD" or f.name.startswith(("_", ".")):
            continue
        meta, body = read_frontmatter(f)
        name = meta.get("name")
        if name != f.stem or not NAME_RE.match(name or ""):
            raise ValueError(f"{f}: name {name!r} must match filename and be lowercase-hyphenated")
        if not meta.get("description"):
            raise ValueError(f"{f}: description is required")
        access = meta.get("access", "full")
        if access not in ACCESS_LEVELS:
            raise ValueError(f"{f}: access must be one of {ACCESS_LEVELS}")
        if not body.strip():
            raise ValueError(f"{f}: body (the subagent's instructions) is empty")
        body = expand_includes(body, f)
        found.append({"name": name, "description": " ".join(str(meta["description"]).split()),
                      "access": access, "meta": meta, "body": body, "src": f})
    return found


# --------------------------------------------------------------------------- #
# Renderers: one per tool. `overrides` = the tool's own frontmatter block,
# passed through verbatim so any native option stays reachable.
# --------------------------------------------------------------------------- #
CLAUDE_READ_ONLY_TOOLS = "Read, Grep, Glob, Bash"


def render_claude(a: dict) -> str:
    meta = {"name": a["name"], "description": a["description"]}
    if a["access"] == "read-only":
        meta["tools"] = CLAUDE_READ_ONLY_TOOLS
    meta.update(a["meta"].get("claude") or {})
    note = GENERATED.format(src=a["src"].relative_to(REPO))
    return yaml_frontmatter(meta) + f"\n<!-- {note} -->\n\n" + a["body"].rstrip() + "\n"


def render_codex(a: dict) -> str:
    fields = {"name": a["name"], "description": a["description"]}
    sandbox = {"read-only": "read-only", "edit": "workspace-write"}.get(a["access"])
    if sandbox:
        fields["sandbox_mode"] = sandbox
    fields.update(a["meta"].get("codex") or {})
    lines = [f"# {GENERATED.format(src=a['src'].relative_to(REPO))}"]
    lines += [f"{k} = {toml_value(v)}" for k, v in fields.items() if not isinstance(v, dict)]
    lines.append(f"developer_instructions = {toml_multiline(a['body'])}")
    for k, v in fields.items():  # tables must come after top-level keys
        if isinstance(v, dict):
            lines.append(f"\n[{k}]")
            lines += [f"{kk} = {toml_value(vv)}" for kk, vv in v.items()]
    return "\n".join(lines) + "\n"


def render_opencode(a: dict) -> str:
    meta: dict = {"description": a["description"], "mode": "subagent"}
    if a["access"] == "read-only":
        meta["permission"] = {"edit": "deny"}
    overrides = dict(a["meta"].get("opencode") or {})
    if "permission" in overrides and isinstance(meta.get("permission"), dict):
        meta["permission"] = {**meta["permission"], **overrides.pop("permission")}
    meta.update(overrides)
    note = GENERATED.format(src=a["src"].relative_to(REPO))
    return yaml_frontmatter(meta) + f"\n<!-- {note} -->\n\n" + a["body"].rstrip() + "\n"


# --------------------------------------------------------------------------- #
# Targets
# --------------------------------------------------------------------------- #
def targets() -> dict:
    return {
        "claude": {"skills": home() / ".claude" / "skills",
                   "agents": home() / ".claude" / "agents", "ext": ".md", "render": render_claude},
        "codex": {"skills": home() / ".agents" / "skills",  # also read by OpenCode, Cursor, Gemini, etc.
                  "agents": codex_home() / "agents", "ext": ".toml", "render": render_codex},
        "opencode": {"skills": home() / ".agents" / "skills",
                     "agents": opencode_home() / "agents", "ext": ".md", "render": render_opencode},
    }


MCP_TOOLS = ("claude", "codex", "opencode")


def empty_manifest() -> dict:
    return {"skills": [], "agents": [], "instructions": [], "mcp": {t: [] for t in MCP_TOOLS}}


def load_manifest() -> dict:
    m = empty_manifest()
    try:
        m.update(json.loads(state_file().read_text()))
    except (FileNotFoundError, json.JSONDecodeError):
        pass
    for t in MCP_TOOLS:
        m["mcp"].setdefault(t, [])
    return m


def save_manifest(m: dict, dry: bool) -> None:
    if dry:
        return
    p = state_file()
    p.parent.mkdir(parents=True, exist_ok=True)
    out = {"skills": sorted(set(m["skills"])), "agents": sorted(set(m["agents"])),
           "instructions": sorted(set(m["instructions"])),
           "mcp":{t: sorted(set(v)) for t, v in m["mcp"].items()}}
    p.write_text(json.dumps(out, indent=2) + "\n")


# --------------------------------------------------------------------------- #
# MCP servers: mcp/<name>.json -> each tool's own config.
# --------------------------------------------------------------------------- #
MCP_SRC = REPO / "mcp"
MCP_KEYS = {"command", "args", "env", "env_from", "cwd", "url", "headers", "headers_from_env",
            "bearer_token_env", "enabled", "description"} | set(MCP_TOOLS)
CODEX_BEGIN = "# >>> agent-setup mcp servers (managed; edit mcp/*.json in agent-setup instead) >>>"
CODEX_END = "# <<< agent-setup mcp servers <<<"


def _read_mcp_file(f: Path, settings: dict | None = None) -> dict:
    name = f.stem
    if not NAME_RE.match(name):
        raise ValueError(f"{f}: filename must be lowercase-hyphenated")
    try:
        text = f.read_text()
        # {placeholder} values: the built-in `repo` (this checkout) plus the local config.
        # Values are JSON-escaped because they are inserted into JSON text.
        for k, v in {"repo": str(REPO), **(settings or {})}.items():
            text = text.replace("{" + k + "}", json.dumps(str(v), ensure_ascii=False)[1:-1])
        spec = json.loads(text)
    except json.JSONDecodeError as e:
        raise ValueError(f"{f}: invalid JSON: {e}") from e
    spec.pop("$comment", None)
    if unknown := set(spec) - MCP_KEYS:
        raise ValueError(f"{f}: unknown keys {sorted(unknown)}")
    if ("command" in spec) == ("url" in spec):
        raise ValueError(f"{f}: set exactly one of 'command' (stdio) or 'url' (http)")
    if "command" in spec and any(k in spec for k in ("headers", "headers_from_env", "bearer_token_env")):
        raise ValueError(f"{f}: headers/bearer_token_env only apply to url servers")
    if "url" in spec and any(k in spec for k in ("args", "env", "env_from", "cwd")):
        raise ValueError(f"{f}: args/env/env_from/cwd only apply to command servers")
    if re.search(r"\{[a-z_]+\}", json.dumps(spec)):
        raise ValueError(f"{f}: unfilled {{placeholder}}; set it with `agent-setup trackers`")
    return {"name": name, "spec": spec, "src": f}


def load_mcp() -> list[dict]:
    """Always-on servers in mcp/*.json, plus mcp/optional/<name>.json for chosen trackers."""
    found = []
    if MCP_SRC.is_dir():
        found += [_read_mcp_file(f) for f in sorted(MCP_SRC.glob("*.json"))]
    catalog, cfg = load_trackers(), load_user_config()
    for tid in cfg.get("trackers", []):
        t = catalog.get(tid)
        if t and t.get("mcp"):
            settings = {**t.get("settings", {}), **cfg.get("settings", {})}
            found.append(_read_mcp_file(MCP_SRC / "optional" / f"{t['mcp']}.json", settings))
    return found


# --------------------------------------------------------------------------- #
# Ticket trackers: catalog in trackers.json (repo), choice in the user's config.
# --------------------------------------------------------------------------- #
TRACKERS_FILE = REPO / "trackers.json"


def user_config_file() -> Path:
    xdg = os.environ.get("XDG_CONFIG_HOME", str(home() / ".config"))
    return Path(xdg) / "agent-setup" / "config.json"


def load_user_config() -> dict:
    try:
        return json.loads(user_config_file().read_text())
    except (FileNotFoundError, json.JSONDecodeError):
        return {}


def save_user_config(cfg: dict) -> None:
    p = user_config_file()
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(json.dumps(cfg, indent=2) + "\n")


def load_trackers() -> dict:
    if not TRACKERS_FILE.exists():
        return {}
    data = json.loads(TRACKERS_FILE.read_text())
    data.pop("$comment", None)
    return data


def cmd_trackers(args) -> int:
    catalog, cfg = load_trackers(), load_user_config()
    ids = list(catalog)
    if args.ask:
        print("Which ticket trackers do you use? (debug-ticket fetches tickets from these;")
        print("pasted ticket text always works.)\n")
        for i, tid in enumerate(ids, 1):
            mark = "x" if tid in cfg.get("trackers", []) else " "
            print(f"  {i}) [{mark}] {catalog[tid]['label']:<24} {catalog[tid]['how']}")
        print("  0)     none: I'll paste tickets")
        try:
            raw = input("\nNumbers or names, comma-separated (Enter keeps the current choice): ").strip()
        except EOFError:
            raw = ""
        if not raw:
            chosen = cfg.get("trackers", [])
        elif raw in ("0", "none"):
            chosen = []
        else:
            chosen = []
            for part in (x.strip().lower() for x in raw.replace(" ", ",").split(",") if x.strip()):
                tid = ids[int(part) - 1] if part.isdigit() and 0 < int(part) <= len(ids) else part
                if tid not in catalog:
                    print(f"unknown choice: {part}", file=sys.stderr)
                    return 2
                chosen.append(tid)
        args.set = ",".join(chosen) if chosen else "none"
    if args.set is not None:
        chosen = [] if args.set in ("", "none") else [x.strip().lower() for x in args.set.split(",") if x.strip()]
        if bad := [t for t in chosen if t not in catalog]:
            print(f"unknown tracker(s): {', '.join(bad)}; choose from {', '.join(ids)}", file=sys.stderr)
            return 2
        cfg["trackers"] = sorted(set(chosen), key=ids.index)
        if args.gitlab_host:
            cfg.setdefault("settings", {})["gitlab_host"] = args.gitlab_host
        elif "gitlab" in chosen and args.ask:
            default = cfg.get("settings", {}).get("gitlab_host", "gitlab.com")
            try:
                host = input(f"GitLab host [{default}]: ").strip()
            except EOFError:
                host = ""
            if host:
                cfg.setdefault("settings", {})["gitlab_host"] = host.removeprefix("https://").rstrip("/")
        save_user_config(cfg)
        print(f"Saved to {user_config_file()}: {', '.join(cfg['trackers']) or 'none (paste tickets)'}")
        print("Run `agent-setup sync` to install or remove the matching MCP servers.")
        return 0
    chosen = cfg.get("trackers")
    print(f"Configured ({user_config_file()}): "
          f"{', '.join(chosen) if chosen else ('none (paste tickets)' if chosen == [] else 'not chosen yet')}")
    for tid in ids:
        print(f"  {'x' if tid in (chosen or []) else ' '} {tid:<8} {catalog[tid]['label']}: {catalog[tid]['how']}")
    print("Change with `agent-setup trackers --ask` or `agent-setup trackers --set github,jira`.")
    return 0


def mcp_claude(s: dict) -> dict:
    if "command" in s:
        out = {"type": "stdio", "command": s["command"], "args": s.get("args", [])}
        env = dict(s.get("env", {}))
        env.update({v: "${" + v + "}" for v in s.get("env_from", [])})
        if env:
            out["env"] = env
    else:
        out = {"type": "http", "url": s["url"]}
        headers = dict(s.get("headers", {}))
        headers.update({h: "${" + v + "}" for h, v in s.get("headers_from_env", {}).items()})
        if s.get("bearer_token_env"):
            headers["Authorization"] = "Bearer ${" + s["bearer_token_env"] + "}"
        if headers:
            out["headers"] = headers
    out.update(s.get("claude", {}))
    return out


def mcp_codex(s: dict) -> dict:
    if "command" in s:
        out = {"command": s["command"]}
        for k in ("args", "env", "cwd"):
            if k in s:
                out[k] = s[k]
        if s.get("env_from"):
            out["env_vars"] = s["env_from"]
    else:
        out = {"url": s["url"]}
        if s.get("headers"):
            out["http_headers"] = s["headers"]
        if s.get("headers_from_env"):
            out["env_http_headers"] = s["headers_from_env"]
        if s.get("bearer_token_env"):
            out["bearer_token_env_var"] = s["bearer_token_env"]
    if s.get("enabled") is False:
        out["enabled"] = False
    out.update(s.get("codex", {}))
    return out


def mcp_opencode(s: dict) -> dict:
    if "command" in s:
        out = {"type": "local", "command": [s["command"], *s.get("args", [])]}
        env = dict(s.get("env", {}))
        env.update({v: "{env:" + v + "}" for v in s.get("env_from", [])})
        if env:
            out["environment"] = env
        if "cwd" in s:
            out["cwd"] = s["cwd"]
    else:
        out = {"type": "remote", "url": s["url"]}
        headers = dict(s.get("headers", {}))
        headers.update({h: "{env:" + v + "}" for h, v in s.get("headers_from_env", {}).items()})
        if s.get("bearer_token_env"):
            headers["Authorization"] = "Bearer {env:" + s["bearer_token_env"] + "}"
        if headers:
            out["headers"] = headers
    if s.get("enabled") is False:
        out["disabled"] = True
    out.update(s.get("opencode", {}))
    return out


def toml_inline(v) -> str:
    if isinstance(v, dict):
        return "{ " + ", ".join(f"{json.dumps(k)} = {toml_inline(x)}" for k, x in v.items()) + " }"
    return toml_value(v)


class McpBackend:
    """One tool's MCP config. Subclasses implement current()/apply()."""
    tool = ""

    def current(self) -> dict:  # name -> installed config
        raise NotImplementedError

    def apply(self, desired: dict, remove: set, dry: bool) -> None:
        raise NotImplementedError


class ClaudeMcp(McpBackend):
    tool = "claude"

    def current(self) -> dict:
        p = Path(os.environ.get("CLAUDE_CONFIG_DIR", str(home()))) / ".claude.json"
        try:
            return json.loads(p.read_text()).get("mcpServers") or {}
        except FileNotFoundError:
            return {}

    def _run(self, *args: str) -> None:
        import shutil
        import subprocess
        if not shutil.which("claude"):
            raise ValueError("`claude` CLI not found on PATH; cannot manage Claude MCP servers")
        r = subprocess.run(["claude", "mcp", *args], capture_output=True, text=True)
        if r.returncode != 0:
            raise ValueError(f"claude mcp {args[0]} failed: {(r.stderr or r.stdout).strip()}")

    def apply(self, desired: dict, remove: set, dry: bool) -> None:
        if dry:
            return
        cur = self.current()
        for name in sorted(remove | {n for n in desired if n in cur}):
            if name in cur:
                self._run("remove", "--scope", "user", name)
        for name, cfg in desired.items():
            self._run("add-json", "--scope", "user", name, json.dumps(cfg))


class CodexMcp(McpBackend):
    tool = "codex"

    def path(self) -> Path:
        return codex_home() / "config.toml"

    def _split(self) -> tuple[str, str]:
        """Return (config text without our block, our block)."""
        try:
            text = self.path().read_text()
        except FileNotFoundError:
            return "", ""
        b, e = text.find(CODEX_BEGIN), text.find(CODEX_END)
        if b == -1 or e == -1:
            return text, ""
        return text[:b].rstrip("\n") + "\n" + text[e + len(CODEX_END):].lstrip("\n"), text[b:e]

    def current(self) -> dict:
        import tomllib
        text = self.path().read_text() if self.path().exists() else ""
        return tomllib.loads(text).get("mcp_servers") or {}

    def unmanaged(self) -> set:
        import tomllib
        return set((tomllib.loads(self._split()[0]).get("mcp_servers") or {}))

    def apply(self, desired: dict, remove: set, dry: bool) -> None:
        import tomllib
        rest, _ = self._split()
        if remove & self.unmanaged():  # adopting: drop the user's original tables
            rest = self._strip_tables(rest, remove & self.unmanaged())
        block = ""
        if desired:
            lines = [CODEX_BEGIN]
            for name, cfg in sorted(desired.items()):
                lines.append(f"[mcp_servers.{json.dumps(name)}]")
                lines += [f"{k} = {toml_inline(v)}" for k, v in cfg.items()]
                lines.append("")
            lines.append(CODEX_END)
            block = "\n".join(lines) + "\n"
        new = (rest.rstrip("\n") + "\n\n" + block) if block else rest
        tomllib.loads(new)  # never write a config Codex can't parse
        if dry or (self.path().exists() and self.path().read_text() == new):
            return
        p = self.path()
        if p.exists():
            p.with_name(p.name + ".agent-setup.bak").write_text(p.read_text())
        p.parent.mkdir(parents=True, exist_ok=True)
        p.write_text(new)

    @staticmethod
    def _strip_tables(text: str, names: set) -> str:
        out, skipping = [], False
        for line in text.splitlines(keepends=True):
            m = re.match(r'^\s*\[\s*mcp_servers\.("?)([A-Za-z0-9_-]+)\1(\.[^\]]*)?\s*\]', line)
            if line.lstrip().startswith("["):
                skipping = bool(m and m.group(2) in names)
            if not skipping:
                out.append(line)
        return "".join(out)


class OpencodeMcp(McpBackend):
    tool = "opencode"

    def path(self) -> Path:
        for n in ("opencode.json", "opencode.jsonc"):
            if (opencode_home() / n).exists():
                return opencode_home() / n
        return opencode_home() / "opencode.json"

    def _load(self) -> dict:
        p = self.path()
        if not p.exists():
            return {"$schema": "https://opencode.ai/config.json"}
        try:
            return json.loads(p.read_text())
        except json.JSONDecodeError as e:
            raise ValueError(f"{p} has comments or is not plain JSON; can't edit it safely ({e})") from e

    def current(self) -> dict:
        return ((self._load().get("mcp") or {}).get("servers")) or {}

    def apply(self, desired: dict, remove: set, dry: bool) -> None:
        cfg = self._load()
        servers = cfg.setdefault("mcp", {}).setdefault("servers", {})
        before = json.dumps(cfg, sort_keys=True)
        for n in remove:
            servers.pop(n, None)
        servers.update(desired)
        if dry or json.dumps(cfg, sort_keys=True) == before:
            return
        self.path().parent.mkdir(parents=True, exist_ok=True)
        self.path().write_text(json.dumps(cfg, indent=2, ensure_ascii=False) + "\n")


MCP_BACKENDS = {"claude": (ClaudeMcp, mcp_claude), "codex": (CodexMcp, mcp_codex),
                "opencode": (OpencodeMcp, mcp_opencode)}


def sync_mcp(tools: list[str], old: dict, new: dict, dry: bool, adopt: bool) -> int:
    servers = load_mcp()
    print(f"MCP servers ({len(servers)}):")
    conflicts = 0
    for tool in tools:
        backend_cls, render = MCP_BACKENDS[tool]
        backend = backend_cls()
        managed_before = set(old["mcp"].get(tool, []))
        try:
            current = backend.current()
        except Exception as e:  # missing/broken config: report and move on
            print(f"  SKIP      {tool}: {e}")
            new["mcp"][tool] = list(managed_before)
            conflicts += 1
            continue
        desired, adopted = {}, set()
        for s in servers:
            name, cfg = s["name"], render(s["spec"])
            label = f"{tool}:{name}"
            if name in current and name not in managed_before:
                if not adopt:
                    print(f"  CONFLICT  {label}  (already configured, not managed by agent-setup; "
                          f"use --adopt to take it over)")
                    conflicts += 1
                    continue
                adopted.add(name)
                print(f"  adopt     {label}")
            elif current.get(name) == cfg or (tool == "claude" and name in current
                                               and all(current[name].get(k) == v for k, v in cfg.items())):
                print(f"  ok        {label}")
            else:
                print(f"  {'update' if name in current else 'add':<9} {label}")
            desired[name] = cfg
        stale = managed_before - {s["name"] for s in servers}
        for n in sorted(stale):
            print(f"  remove    {tool}:{n}")
        # Claude only needs calls for servers that actually change.
        if tool == "claude":
            changed = {n: c for n, c in desired.items()
                       if n in adopted or n not in current
                       or not all(current[n].get(k) == v for k, v in c.items())}
            backend.apply(changed, stale | adopted, dry)
        else:
            backend.apply(desired, stale | adopted, dry)
        new["mcp"][tool] = sorted(desired)
    return conflicts


# --------------------------------------------------------------------------- #
# Managed instruction blocks: shared/<name>-instructions.md -> each tool's global
# instruction file. Only the text between our markers is ever touched.
# --------------------------------------------------------------------------- #
INSTR_NAMES = ("memory", "devservers")


def instr_src(name: str) -> Path:
    return REPO / "shared" / f"{name}-instructions.md"


def instr_begin(name: str) -> str:
    return f"<!-- >>> agent-setup {name} (managed; edit shared/{name}-instructions.md) >>> -->"


def instr_end(name: str) -> str:
    return f"<!-- <<< agent-setup {name} <<< -->"


INSTR_BEGIN = instr_begin("memory")
INSTR_END = instr_end("memory")


def instruction_files() -> dict[str, Path]:
    return {"claude": home() / ".claude" / "CLAUDE.md",
            "codex": codex_home() / "AGENTS.md",
            "opencode": opencode_home() / "AGENTS.md"}


def load_instruction_block(name: str = "memory") -> str | None:
    """The managed block (markers included, no trailing newline), or None if there is no source."""
    src = instr_src(name)
    if not src.is_file():
        return None
    return f"{instr_begin(name)}\n{src.read_text(encoding='utf-8').strip()}\n{instr_end(name)}"


def instruction_blocks() -> dict[str, str]:
    """Every managed block that has a source file, by name, in install order."""
    return {n: b for n in INSTR_NAMES if (b := load_instruction_block(n))}


def _block_span(text: str, path: Path, name: str = "memory") -> tuple[int, int] | None:
    begin, end = instr_begin(name), instr_end(name)
    b, e = text.find(begin), text.find(end)
    if b == -1 and e == -1:
        return None
    if b == -1 or e == -1 or e < b:
        raise ValueError(f"{path}: agent-setup {name} markers are unbalanced; fix or remove them by hand")
    return b, e + len(end)


def with_block(text: str, block: str, path: Path, name: str = "memory") -> str:
    """Replace our block in place, or append it after the existing text."""
    span = _block_span(text, path, name)
    if span:
        return text[:span[0]] + block + text[span[1]:]
    if not text:
        return block + "\n"
    sep = "" if text.endswith("\n\n") else ("\n" if text.endswith("\n") else "\n\n")
    return text + sep + block + "\n"


def without_block(text: str, path: Path, name: str = "memory") -> str:
    span = _block_span(text, path, name)
    if not span:
        return text
    before, after = text[:span[0]], text[span[1]:]
    after = after[1:] if after.startswith("\n") else after
    if before.endswith("\n\n"):  # the blank separator we added when appending
        before = before[:-1]
    return before + after


def read_text_exact(path: Path) -> str:
    return path.read_bytes().decode("utf-8") if path.exists() else ""


def sync_instructions(tools: list[str], old: dict, new: dict, dry: bool) -> None:
    blocks = instruction_blocks()
    files = instruction_files()
    print(f"Instruction blocks ({len(tools) if blocks else 0}):")
    chosen = {str(files[t]) for t in tools}
    keep = {str(p) for t, p in files.items() if t not in tools}  # tools not in this run keep their entries
    for t in tools:
        path = files[t]
        if not blocks:
            continue
        original = text = read_text_exact(path)
        exists = path.exists()
        for name, block in blocks.items():
            out = with_block(text, block, path, name)
            if out == text:
                log("ok", path, f"{name} block")
                continue
            log("update" if exists and _block_span(text, path, name) else ("add" if exists else "create"),
                path, f"{name} block")
            text, exists = out, True
        if str(path) not in new["instructions"]:
            new["instructions"].append(str(path))
        if text != original and not dry:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_bytes(text.encode("utf-8"))
    for p in sorted(set(old["instructions"]) - set(new["instructions"])):
        if p in keep and p not in chosen:
            new["instructions"].append(p)
        else:
            remove_block(Path(p), dry)


def remove_block(path: Path, dry: bool) -> None:
    if not path.is_file():
        return
    original = text = read_text_exact(path)
    for name in INSTR_NAMES:
        out = without_block(text, path, name)
        if out != text:
            log("remove", path, f"{name} block")
            text = out
    if text != original and not dry:
        path.write_bytes(text.encode("utf-8"))


def log(action: str, path: Path, detail: str = "") -> None:
    print(f"  {action:<9} {path}{'  (' + detail + ')' if detail else ''}")


def remove_managed(path: Path, dry: bool) -> None:
    if path.is_symlink() or path.is_file():
        log("remove", path)
        if not dry:
            path.unlink()


def cmd_sync(args) -> int:
    chosen = args.targets.split(",") if args.targets else list(targets())
    tmap = {k: v for k, v in targets().items() if k in chosen}
    if unknown := set(chosen) - set(targets()):
        print(f"unknown target(s): {', '.join(sorted(unknown))}", file=sys.stderr)
        return 2
    skills, agents = load_skills(), load_agents()
    load_mcp()  # validate everything before writing anything, so a bad file can't leave a half-done sync
    for t in tmap:  # same for the instruction files: unbalanced markers stop the sync before any write
        path = instruction_files()[t]
        for name in INSTR_NAMES:
            _block_span(read_text_exact(path), path, name)
    old = load_manifest()
    new = empty_manifest()
    new["mcp"] = {t: list(v) for t, v in old["mcp"].items()}  # tools not in this run keep theirs
    # Keep entries for targets not part of this run so they aren't pruned or forgotten.
    skipped_paths = ({str(t["skills"]) for k, t in targets().items() if k not in tmap}
                     - {str(t["skills"]) for t in tmap.values()})
    skipped_agent_dirs = {str(t["agents"]) for k, t in targets().items() if k not in tmap}
    conflicts = 0

    print(f"Skills ({len(skills)}):")
    for skills_dir in sorted({str(t["skills"]) for t in tmap.values()}):
        d = Path(skills_dir)
        for name, src in skills:
            dest = d / name
            new["skills"].append(str(dest))
            if dest.is_symlink() and Path(os.readlink(dest)) == src:
                log("ok", dest)
                continue
            if dest.exists() or dest.is_symlink():
                if str(dest) not in old["skills"] or not dest.is_symlink():
                    log("CONFLICT", dest, "exists and is not managed by agent-setup; skipped")
                    new["skills"].remove(str(dest))
                    conflicts += 1
                    continue
                if not args.dry_run:
                    dest.unlink()
            log("link", dest, f"-> {src}")
            if not args.dry_run:
                d.mkdir(parents=True, exist_ok=True)
                dest.symlink_to(src, target_is_directory=True)

    print(f"Subagents ({len(agents)}):")
    for tname, t in tmap.items():
        for a in agents:
            dest = t["agents"] / f"{a['name']}{t['ext']}"
            content = t["render"](a)
            new["agents"].append(str(dest))
            if dest.exists() and str(dest) not in old["agents"]:
                log("CONFLICT", dest, "exists and is not managed by agent-setup; skipped")
                new["agents"].remove(str(dest))
                conflicts += 1
                continue
            if dest.is_file() and dest.read_text(encoding="utf-8") == content:
                log("ok", dest)
                continue
            log("write", dest, tname)
            if not args.dry_run:
                dest.parent.mkdir(parents=True, exist_ok=True)
                dest.write_text(content, encoding="utf-8")

    # Prune things we installed previously that no longer have a source.
    for p in set(old["skills"]) - set(new["skills"]):
        if str(Path(p).parent) in skipped_paths:
            new["skills"].append(p)
        else:
            remove_managed(Path(p), args.dry_run)
    for p in set(old["agents"]) - set(new["agents"]):
        if str(Path(p).parent) in skipped_agent_dirs:
            new["agents"].append(p)
        else:
            remove_managed(Path(p), args.dry_run)

    conflicts += sync_mcp([t for t in MCP_TOOLS if t in tmap], old, new, args.dry_run, args.adopt)
    sync_instructions([t for t in MCP_TOOLS if t in tmap], old, new, args.dry_run)

    save_manifest(new, args.dry_run)
    if args.dry_run:
        print("(dry run: nothing changed)")
    if conflicts:
        print(f"{conflicts} conflict(s); see above", file=sys.stderr)
    return 1 if conflicts else 0


def cmd_uninstall(args) -> int:
    m = load_manifest()
    for p in m["skills"] + m["agents"]:
        remove_managed(Path(p), args.dry_run)
    for p in m["instructions"]:
        remove_block(Path(p), args.dry_run)
    for tool, names in m["mcp"].items():
        if names:
            for n in names:
                print(f"  remove    {tool}:{n}")
            MCP_BACKENDS[tool][0]().apply({}, set(names), args.dry_run)
    save_manifest(empty_manifest(), args.dry_run)
    return 0


def cmd_status(_args) -> int:
    m = load_manifest()
    skills, agents = load_skills(), load_agents()
    print(f"Source: {REPO}")
    print(f"  skills:    {', '.join(n for n, _ in skills) or '(none)'}")
    print(f"  subagents: {', '.join(a['name'] for a in agents) or '(none)'}")
    print(f"  mcp:       {', '.join(s['name'] for s in load_mcp()) or '(none)'}")
    print(f"Installed ({state_file()}):")
    for p in m["skills"] + m["agents"]:
        path = Path(p)
        state = "ok" if (path.exists() or path.is_symlink()) else "MISSING"
        print(f"  {state:<8} {p}")
    for p in m["instructions"]:
        path = Path(p)
        for name in instruction_blocks():
            state = "ok" if path.is_file() and _block_span(read_text_exact(path), path, name) else "MISSING"
            print(f"  {state:<8} {p}  ({name} block)")
    for tool, names in m["mcp"].items():
        for n in names:
            print(f"  mcp      {tool}:{n}")
    return 0


def memory_store_root() -> Path:
    """Where mcp/servers/memory.py keeps its files (same rule, kept in sync by hand)."""
    if os.environ.get("AGENT_MEMORY_DIR"):
        return Path(os.environ["AGENT_MEMORY_DIR"]).expanduser()
    xdg = os.environ.get("XDG_DATA_HOME")
    return (Path(xdg).expanduser() if xdg else home() / ".local" / "share") / "agent-memory"


def devservers_state_root() -> Path:
    """Where mcp/servers/devservers.py keeps its state (same rule, kept in sync by hand)."""
    if os.environ.get("DEVSERVERS_DIR"):
        return Path(os.environ["DEVSERVERS_DIR"]).expanduser()
    xdg = os.environ.get("XDG_STATE_HOME")
    return (Path(xdg).expanduser() if xdg else home() / ".local" / "state") / "devservers"


def claude_auto_memory_off() -> tuple[bool, str]:
    """Is Claude Code's built-in auto-memory off? CLAUDE_CODE_DISABLE_AUTO_MEMORY outranks the setting."""
    env = os.environ.get("CLAUDE_CODE_DISABLE_AUTO_MEMORY", "").strip().lower()
    if env in ("1", "true", "yes"):
        return True, "off (CLAUDE_CODE_DISABLE_AUTO_MEMORY is set)"
    if env in ("0", "false", "no"):
        return False, "forced on by CLAUDE_CODE_DISABLE_AUTO_MEMORY=0"
    settings = home() / ".claude" / "settings.json"
    try:
        value = json.loads(settings.read_text(encoding="utf-8")).get("autoMemoryEnabled")
    except (OSError, json.JSONDecodeError, AttributeError):
        value = None
    if value is False:
        return True, f"off (autoMemoryEnabled is false in {settings})"
    return False, "still on (autoMemoryEnabled is not false); the memory server is meant to replace it"


def cmd_doctor(_args) -> int:
    """Check prerequisites, sources and installed state; exit 1 if anything needs fixing."""
    import shutil
    import subprocess
    problems = 0

    def report(ok: bool, msg: str, fix: str = "") -> None:
        nonlocal problems
        if not ok:
            problems += 1
        print(f"  {'ok  ' if ok else 'FIX '} {msg}" + (f"\n         -> {fix}" if fix and not ok else ""))

    print("Prerequisites")
    report(sys.version_info >= (3, 11), f"Python {sys.version.split()[0]} (need 3.11+)",
           "install Python 3.11 or newer")
    report(bool(shutil.which("git")), "git on PATH", "install git")
    on_path = shutil.which("agent-setup")
    print(f"  {'ok  ' if on_path else 'info'} agent-setup on PATH: {on_path or 'no (run ./install.sh to add it)'}")
    found = {t: shutil.which(t) for t in MCP_TOOLS}
    for t, p in found.items():
        print(f"  {'ok  ' if p else 'info'} {t} CLI: {p or 'not installed (its targets are still written)'}")

    print("Sources")
    try:
        skills, agents, servers = load_skills(), load_agents(), load_mcp()
        for a in agents:
            for t in targets().values():
                t["render"](a)
        report(True, f"{len(skills)} skill(s), {len(agents)} subagent(s), {len(servers)} MCP server(s) valid")
    except ValueError as e:
        report(False, f"invalid source: {e}", "fix the file, then run `agent-setup validate`")
        return 1

    print("Installed")
    m = load_manifest()
    stale = 0
    for name, src in skills:
        for d in sorted({str(t["skills"]) for t in targets().values()}):
            dest = Path(d) / name
            ok = dest.is_symlink() and Path(os.readlink(dest)) == src
            stale += not ok
            if not ok:
                report(False, f"skill {name} not linked at {dest}", "run `agent-setup sync`")
    for tname, t in targets().items():
        for a in agents:
            dest = t["agents"] / f"{a['name']}{t['ext']}"
            ok = dest.is_file() and dest.read_text(encoding="utf-8") == t["render"](a)
            stale += not ok
            if not ok:
                state = "out of date" if dest.exists() else "missing"
                report(False, f"subagent {a['name']} for {tname} {state} ({dest})", "run `agent-setup sync`")
    for tool in MCP_TOOLS:
        for s in servers:
            if s["name"] not in m["mcp"].get(tool, []):
                stale += 1
                report(False, f"MCP server {s['name']} not installed for {tool}", "run `agent-setup sync`")
    for name, block in instruction_blocks().items():
        for tool, path in instruction_files().items():
            ok = block in read_text_exact(path)
            stale += not ok
            if not ok:
                report(False, f"{name} instructions missing or out of date for {tool} ({path})",
                       "run `agent-setup sync`")
    gone = [p for p in m["skills"] + m["agents"] if not (Path(p).exists() or Path(p).is_symlink())]
    for p in gone:
        report(False, f"installed file missing: {p}", "run `agent-setup sync`")
    if not stale and not gone:
        report(True, "everything in the repo is installed and up to date")

    print("Memory")
    root = memory_store_root()
    print(f"  info memory store: {root}")
    if re.match(r"^/mnt/[a-zA-Z]/", str(root)):
        print("  warn the memory store is on a Windows drive under WSL (slow, file modes are not kept)\n"
              "         -> set AGENT_MEMORY_DIR to a path in your Linux home")
    if found["claude"] or (home() / ".claude").exists():
        off, why = claude_auto_memory_off()
        print(f"  {'ok  ' if off else 'todo'} Claude auto-memory: {why}"
              + ("" if off else "\n         -> set \"autoMemoryEnabled\": false in ~/.claude/settings.json "
                                "(or toggle it with /memory), and unset CLAUDE_CODE_DISABLE_AUTO_MEMORY=0"))

    print("Dev servers")
    dev_root = devservers_state_root()
    print(f"  info devservers state: {dev_root}")
    if re.match(r"^/mnt/[a-zA-Z]/", str(dev_root)):
        print("  warn the devservers state is on a Windows drive under WSL (slow, file modes are not kept)\n"
              "         -> set DEVSERVERS_DIR to a path in your Linux home")

    print("Ticket trackers")
    cfg = load_user_config()
    if "trackers" not in cfg:
        print("  info none chosen yet (pasted tickets still work)\n         -> agent-setup trackers --ask")
    elif not cfg["trackers"]:
        print("  ok   none: tickets are pasted into the chat")
    for tid in cfg.get("trackers", []):
        t = load_trackers().get(tid)
        if not t:
            report(False, f"unknown tracker {tid!r} in {user_config_file()}", "agent-setup trackers --ask")
            continue
        if t.get("cli"):
            if not shutil.which(t["cli"]):
                if t.get("cli_optional"):
                    print(f"  info {t['label']}: `{t['cli']}` not installed; {t['cli_optional']}")
                else:
                    report(False, f"{t['label']}: `{t['cli']}` not installed", f"install {t['cli']}, then {t.get('auth_fix', '')}")
                continue
            r = subprocess.run(t["auth_check"], capture_output=True, text=True, timeout=30, stdin=subprocess.DEVNULL)
            report(r.returncode == 0, f"{t['label']}: `{' '.join(t['auth_check'])}`",
                   f"run `{t.get('auth_fix', '')}`")
        if t.get("mcp"):
            print(f"  ok   {t['label']}: via MCP server `{t['mcp']}` (sign-in status below)")

    if servers:
        print("MCP sign-in (servers that use OAuth need a one-time login per tool)")
        for s in servers:
            if found["claude"]:
                r = subprocess.run(["claude", "mcp", "get", s["name"]], capture_output=True, text=True,
                                   timeout=60, stdin=subprocess.DEVNULL)
                status = next((l.split(":", 1)[1].strip() for l in r.stdout.splitlines()
                               if l.strip().startswith("Status:")), "unknown")
                ok = "auth" not in status.lower() and "fail" not in status.lower()
                print(f"  {'ok  ' if ok else 'todo'} claude:{s['name']}: {status}"
                      + ("" if ok else "\n         -> in Claude Code run /mcp and sign in"))
            if found["codex"]:
                r = subprocess.run(["codex", "mcp", "list"], capture_output=True, text=True,
                                   timeout=60, stdin=subprocess.DEVNULL)
                line = next((l for l in r.stdout.splitlines() if l.split()[:1] == [s["name"]]), "")
                auth = "logged in" if re.search(r"\b(OAuth|Bearer token)\b", line) and "Not logged in" not in line \
                    else ("not logged in" if line else "unknown")
                print(f"  {'ok  ' if auth == 'logged in' else 'info'} codex:{s['name']}: {auth}"
                      + ("" if auth == "logged in" else f"\n         -> run `codex mcp login {s['name']}` if it needs OAuth"))
            if found["opencode"]:
                print(f"  info opencode:{s['name']}: check with `opencode mcp list`; "
                      f"sign in with `opencode mcp auth {s['name']}`")

    print(f"\n{'All good.' if not problems else f'{problems} thing(s) to fix (see FIX lines above).'}")
    return 1 if problems else 0


def cmd_validate(_args) -> int:
    skills, agents, servers = load_skills(), load_agents(), load_mcp()
    # Also check every optional tracker server, chosen or not, with its default settings.
    for tid, t in load_trackers().items():
        if t.get("mcp"):
            _read_mcp_file(MCP_SRC / "optional" / f"{t['mcp']}.json", t.get("settings", {}))
    for s in servers:
        for _, render in MCP_BACKENDS.values():
            render(s["spec"])
    for a in agents:  # make sure every renderer accepts every agent
        for t in targets().values():
            t["render"](a)
    print(f"ok: {len(skills)} skill(s), {len(agents)} subagent(s), {len(servers)} MCP server(s)")
    return 0


SKILL_TEMPLATE = """---
name: {name}
description: >
  TODO: What this skill does and when to use it. Be specific about trigger
  phrases and situations; agents decide whether to load the skill from this
  text alone.
---

# {title}

TODO: Instructions the agent follows once the skill is loaded.
"""

AGENT_TEMPLATE = """---
name: {name}
description: >
  TODO: What this subagent is for and when the main agent should delegate to it.
access: read-only   # read-only | edit | full
# Optional per-tool overrides, passed through verbatim:
# claude:
#   model: sonnet
# codex:
#   model_reasoning_effort: high
# opencode:
#   temperature: 0.1
---

TODO: The subagent's system prompt.
"""


MCP_TEMPLATE = """{
  "$comment": "stdio server: command/args/env/env_from. HTTP server: url/headers/headers_from_env/bearer_token_env. Never put secrets here; list their env var names in env_from / bearer_token_env.",
  "command": "TODO",
  "args": [],
  "env_from": []
}
"""


def cmd_new(args) -> int:
    if not NAME_RE.match(args.name):
        print("name must be lowercase letters, digits and hyphens", file=sys.stderr)
        return 2
    title = args.name.replace("-", " ").title()
    if args.kind == "skill":
        dest = SKILLS_SRC / args.name / "SKILL.md"
        content = SKILL_TEMPLATE.format(name=args.name, title=title)
    elif args.kind == "mcp":
        dest = MCP_SRC / f"{args.name}.json"
        content = MCP_TEMPLATE
    else:
        dest = AGENTS_SRC / f"{args.name}.md"
        content = AGENT_TEMPLATE.format(name=args.name)
    if dest.exists():
        print(f"{dest} already exists", file=sys.stderr)
        return 1
    dest.parent.mkdir(parents=True, exist_ok=True)
    dest.write_text(content)
    print(f"created {dest.relative_to(REPO)}")
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(prog="agent-setup", description=__doc__.split("\n")[0])
    sub = ap.add_subparsers(dest="cmd", required=True)
    s = sub.add_parser("sync", help="install/update skills, subagents and MCP servers")
    s.add_argument("-n", "--dry-run", action="store_true")
    s.add_argument("--adopt", action="store_true",
                   help="take over MCP servers that already exist under the same name")
    s.add_argument("-t", "--targets", help=f"comma list, default all: {','.join(targets())}")
    s.set_defaults(fn=cmd_sync)
    u = sub.add_parser("uninstall", help="remove everything agent-setup installed")
    u.add_argument("-n", "--dry-run", action="store_true")
    u.set_defaults(fn=cmd_uninstall)
    sub.add_parser("status", help="show sources and installed files").set_defaults(fn=cmd_status)
    sub.add_parser("validate", help="check all sources without installing").set_defaults(fn=cmd_validate)
    tr = sub.add_parser("trackers", help="choose which ticket trackers debug-ticket connects to")
    tr.add_argument("--ask", action="store_true", help="choose interactively")
    tr.add_argument("--set", metavar="LIST", help="e.g. github,jira  (or 'none')")
    tr.add_argument("--gitlab-host", help="self-managed GitLab host, e.g. gitlab.example.com")
    tr.set_defaults(fn=cmd_trackers)
    sub.add_parser("doctor", help="check prerequisites, install state and MCP sign-in").set_defaults(fn=cmd_doctor)
    n = sub.add_parser("new", help="scaffold a new skill, subagent or MCP server")
    n.add_argument("kind", choices=["skill", "agent", "mcp"])
    n.add_argument("name")
    n.set_defaults(fn=cmd_new)
    args = ap.parse_args()
    try:
        return args.fn(args)
    except ValueError as e:
        print(f"error: {e}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
